# ICPADS 2025 会议系统环境变量配置示例
# 复制此文件为 .env 并填入实际值

# 1. 系统环境变量（System Environment Variables）
# 2. 用户环境变量（User Environment Variables）  
# 3. 当前会话环境变量（如 set, export 命令）
# 4. .env 文件（dotenv）
# 5. 代码中的默认值

# 会议名称配置
CONFREG_CONFERENCE_NAME=ICPADS 2025
CONFREG_CONFERENCE_NAME_SHORT=ICPADS2025

# 数据库配置（SQLite）
CONFREG_DB_PATH=./server/database/icpads2025.sqlite
# 或使用绝对路径：
# CONFREG_DB_PATH=/absolute/path/to/database/icpads2025.sqlite

# 邮箱服务配置（阿里云企业邮箱）
CONFREG_EMAIL_HOST=smtp.qiye.aliyun.com
CONFREG_EMAIL_PORT=465
CONFREG_EMAIL_USER=registration@ieee-icpads.org.cn
CONFREG_EMAIL_PASSWORD=your_email_password
CONFREG_EMAIL_FROM_NAME=ICPADS 2025
CONFREG_EMAIL_FROM_ADDRESS=registration@ieee-icpads.org.cn

# 前端地址
CONFREG_FE_URL=
# 不配置的话，默认使用 http://localhost:8080

# 服务器配置
CONFREG_BE_PORT=3000
NODE_ENV=development


# 密码加密配置
# BCRYPT_SALT_ROUNDS: 用于密码哈希的盐轮数，建议值：10-12
# 值越高安全性越高，但计算时间也越长
# 范围：4-20，默认：10
BCRYPT_SALT_ROUNDS=10

# 默认管理员配置
# CONFREG_ADMIN_DEFAULT_PASSWORD: 超级用户（admin）的默认密码
# 建议在生产环境中使用强密码，首次登录后立即更改
CONFREG_ADMIN_DEFAULT_PASSWORD=admin123456

# CONFREG_ADMIN_DEFAULT_EMAIL: 超级用户（admin）的默认邮箱
# 建议使用实际的管理员邮箱地址
CONFREG_ADMIN_DEFAULT_EMAIL=admin@example.com

# 其他配置
UPLOAD_PATH=uploads
MAX_FILE_SIZE=10485760


# 例如：自定义到D盘
# CONFREG_PDF_TEMP_DIR=D:\PDF_TEMP
# 例如：使用相对路径（相对于项目根目录）
# CONFREG_PDF_TEMP_DIR=./custom-pdf-temp


# 日志配置
# CONFREG_LOG_DIR: 日志文件存储目录
# 留空将使用默认目录 server/logs，也可以指定自定义绝对路径
CONFREG_LOG_DIR=

# LOG_LEVEL: 日志级别 (error, warn, info, debug)
# 默认为 info，生产环境建议使用 warn 或 error
LOG_LEVEL=info